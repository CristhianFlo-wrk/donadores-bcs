PORT=3000

NODE_ENV=development

# PostgreSQL local (docker-compose.yml). En Render se inyecta automaticamente
DATABASE_URL=postgresql://donadores:donadores123@localhost:5432/donadores_bcs

# AES-256 (32 bytes en hex = 64 caracteres)
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC-SHA256 para CURP (32 bytes en hex). No cambiar una vez que haya donantes registrados
HASH_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# JWT
JWT_SECRET=se_cambiara_por_un_secreto_largo_en_el_futuro
JWT_EXPIRES_IN=8h

# Firebase
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
