PORT=3000

NODE_ENV=development

DATABASE_URL=postgresql://donadores:donadores123@localhost:5432/donadores_bcs

# AES-256 (32 bytes en hex = 64 caracteres). No cambiar una vez que haya datos cifrados
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC-SHA256 para CURP (32 bytes en hex). No cambiar una vez que haya donantes registrados
HASH_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# JWT (en produccion minimo 32 caracteres)
JWT_SECRET=se_cambiara_por_un_secreto_largo_en_el_futuro
JWT_EXPIRES_IN=8h

# Origenes permitidos separados por coma. Vacio = cualquiera (solo desarrollo). Obligatorio en produccion
CORS_ORIGIN=

# Logins fallidos permitidos por IP cada 15 minutos
LOGIN_MAX_INTENTOS=10

# Firebase (opcional). Sin FIREBASE_PROJECT_ID las notificaciones son simuladas por consola
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# JSON completo de la cuenta de servicio en una sola linea (necesario en Render)
FIREBASE_SERVICE_ACCOUNT=

# Solo para npm run crear-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
